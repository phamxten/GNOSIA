# Copy to backend/.env and fill in.
GNOSIA_DATABASE_URL=postgresql+psycopg://gnosia:CHANGE_ME@localhost:5432/gnosia
GNOSIA_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Set to true when served over HTTPS
GNOSIA_COOKIE_SECURE=false
# Only used by scripts/setup_postgres.py to create the role and database
GNOSIA_PG_SUPERUSER_PASSWORD=
